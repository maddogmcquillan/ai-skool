{
  "name": "ai-skool",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Circle community tooling for the AI Skool launch: Meta Conversions API bridge, AI answer bot, and community provisioning.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/src/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "provision": "tsx scripts/provision.ts",
    "provision:dry": "tsx scripts/provision.ts --dry-run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@hono/node-server": "^2.1.1",
    "hono": "^4.13.8",
    "minisearch": "^7.2.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vitest": "^5.0.1"
  }
}
