# ---- Service ----
PORT=8787
# Shared secret that Zapier must send in the X-Hook-Secret header on every webhook call.
HOOK_SECRET=change-me-to-a-long-random-string
# Set to 1 to skip external calls (Meta + Claude). Useful while wiring up Zaps.
DRY_RUN=0

# ---- Meta Conversions API (server side purchase events) ----
# With CIRCLE_ADMIN_TOKEN also set, the service polls Circle's paid charges every minute and sends
# each new one to Meta itself (no Zapier). META_POLL=0 turns that off in favour of the webhook.
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
META_API_VERSION=v25.0
META_POLL=1
META_POLL_SECONDS=60
# On start, charges from this many hours back are (re)sent; Meta drops duplicates by event_id.
META_LOOKBACK_HOURS=24
# Paywall display name -> internal name, when they differ. Default: the display name slugified.
META_PAYWALL_KEYS=Founding Member=founding-member
# Optional: paste the test code from Meta Events Manager > Test events while validating.
META_TEST_EVENT_CODE=
# The URL that browser purchase events report as event_source_url (your paywall checkout page).
CAPI_DEFAULT_SOURCE_URL=https://www.joinlearnai.com/checkout/founding-member
CAPI_CURRENCY=USD

# ---- AI answer bot ----
# Claude API key. Leave empty to run in DRY_RUN mode.
ANTHROPIC_API_KEY=
ANSWER_MODEL=claude-opus-5
ANSWER_EFFORT=medium
KNOWLEDGE_DIR=./knowledge
# Email of the Circle member account the bot posts as (so it ignores its own comments).
BOT_AUTHOR_EMAIL=coach@example.com
# Circle Admin API v2 token (Business plan and above). Create it while signed in as the Coach
# account: comments made through the API are authored by the token's creator.
CIRCLE_ADMIN_TOKEN=
CIRCLE_API_BASE=https://app.circle.so/api/admin/v2

# ---- Coach poller (on whenever CIRCLE_ADMIN_TOKEN is set; COACH_POLL=0 turns it off) ----
COACH_POLL=1
COACH_SPACE_SLUG=ask-coach
COACH_POLL_SECONDS=60
# Posts older than this many days are never answered (protects old threads on a fresh deploy).
COACH_LOOKBACK_DAYS=14
# Extra authors Coach must leave alone, comma separated. TEAM_AUTHOR_EMAIL is always included.
COACH_IGNORE_EMAILS=
TEAM_AUTHOR_EMAIL=
